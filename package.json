{
	"name": "@noresources/command",
	"version": "0.3.2",
	"description": "A lightweight command line interface definition package focusing on reusability, extensibility and a clean API",
	"main": "index.js",
	"scripts": {
		"test": "tape tests/tape/*.mjs tests/tape/commander/*.mjs tests/tape/fs/*.mjs",
		"lint": "eslint --fix",
		"doc": "jsdoc --recurse -c resources/jsdoc/configuration.json --readme README.md --tutorials resources/jsdoc/tutorials --destination doc src/"
	},
	"keywords": [

	],
	"author": "",
	"license": "ISC",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/noresources/js-command.git"
	},
	"dependencies": {
		"@noresources/core": "^0.2.0"
	},
	"devDependencies": {
		"commander": "^15.0.0",
		"tape": "^2.9.1"
	},
	"type": "module",
	"files": [
		"./src",
		"./index.mjs"
	],
	"module": "./index.mjs",
	"exports": {
		".": [
			{
				"import": "./index.mjs"
			},
			"./index.mjs"
		],
		"./commander": [
			{
				"import": "./src/commander/index.mjs"
			},
			"./src/commander/index.mjs"
		],
		"./fs": [
			{
				"import": "./src/fs/index.mjs"
			},
			"./src/fs/index.mjs"
		],
		"./lib/options": [
			{
				"import": "./src/lib/options/index.mjs"
			},
			"./src/lib/options/index.mjs"
		]
	}
}